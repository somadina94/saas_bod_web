# Public API path (browser). Often /api/v1 when nginx proxies to the backend.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Server-side proxy target (Next rewrites). Use the public API URL in production.
BACKEND_INTERNAL_URL=https://saasbodapi.jahbyte.com

# Canonical site URL (PWA, metadata, links).
NEXT_PUBLIC_SITE_URL=https://saasbod.jahbyte.com

# Optional: manual VPS deploy only (PAT with read:packages). CI logs in automatically.
# GHCR_PULL_TOKEN=
# GHCR_USERNAME=somadina94

# Optional override (default matches GHCR package from GitHub Actions)
# SAASBOD_WEB_IMAGE=ghcr.io/somadina94/saas_bod_web:latest
